# Supabase · valores en el dashboard del proyecto (Settings → API)
# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública, segura para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role (SECRETA · solo servidor, nunca expuesta al cliente)
SUPABASE_SERVICE_ROLE_KEY=
# Password de la base de datos (solo para psql; NUNCA db push/link: proyecto compartido, ver README)
SUPABASE_DB_PASSWORD=

# Código de invitación requerido para registrarse (validado server-side)
INVITE_CODE=
